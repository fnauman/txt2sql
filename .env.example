# Default: the scripts load .env from the current working directory (the web
# server defaults to the repository-root .env).
# Optional override: choose exactly one alternate source instead.
#   --dotenv=/absolute/or/relative/path/.env   (not --env-file: Node.js reserves that flag)
#   --env-dir=/absolute/or/relative/path
#   --use-home-env
# Or via environment variables:
#   ENV_FILE=/path/to/.env
#   ENV_DIR=/path/to/folder
#   USE_HOME_ENV=1

OPENAI_API_KEY=sk-your-key-here
# Public default for the standard OpenAI SDK endpoint. If you use an
# OpenAI-compatible gateway, set MODEL_NAME and OPENAI_BASE_URL together.
# MODEL_NAME=                  # leave unset: gpt-6-luna at reasoning effort low, the default (README "Models")
# Per-HTTP-attempt timeout and transport retries for the OpenAI SDK (defaults shown).
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=demo_retail

# Query user. Everything that runs model-generated SQL (web app, basic,
# optimized, evaluate, resolve-master-data) connects as DB_USER, which must be
# SELECT-only: the database grants are the real security boundary. Docker
# Compose creates demo_readonly with SELECT on demo_retail* only
# (docker/mariadb/initdb/01-readonly-user.sh); the app warns if the user has
# more than SELECT.
DB_USER=demo_readonly
DB_PASSWORD=change-me-readonly
# Password Docker Compose gives the query user when the data volume is FIRST
# initialized. Defaults to DB_PASSWORD, which is what you want with
# DB_USER=demo_readonly; compose refuses to start when both are empty.
# (To change it later: `docker compose down -v`.)
# DB_READONLY_PASSWORD=change-me-readonly
# DB_READONLY_USER=demo_readonly

# Admin user. Only bootstrap-db and seed-demo (DDL + inserts) use it.
# Its password is the first non-empty of DB_ADMIN_PASSWORD, MARIADB_ROOT_PASSWORD,
# DB_PASSWORD; Docker Compose initializes root's password in the same order, so
# set one of the first two. Empty values count as unset. With no admin setting
# at all, the admin scripts fall back to DB_USER and print a warning.
DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=
# Root password for the local Docker Compose MariaDB (and the default admin password).
MARIADB_ROOT_PASSWORD=change-me-root

# Statement timeout for generated SQL on every path, in ms (0 disables).
# The web server uses WEB_QUERY_STATEMENT_TIMEOUT_MS instead when that is set.
# QUERY_STATEMENT_TIMEOUT_MS=8000

# Schema scope of the optimized prompt and the validator's table allow-list
# (web, optimized CLI, npm run eval, verify-dataset; defaults shown).
#   auto      full while the full in-scope schema fits SCHEMA_FULL_MAX_TOKENS
#             estimated tokens (characters / 4), else retrieved
#   full      every in-scope table in one cacheable prompt prefix, all allowed;
#             retrieval only ranks tables as a hint
#   retrieved only the retrieved tables (the behaviour before this setting)
# SCHEMA_WIDEN_ON_DEMAND=1 retries a TABLE_SCOPE rejection of an in-scope table
# with that table added. Default: on when auto falls back to retrieved, off for
# an explicit SCHEMA_SCOPE=retrieved (which then reproduces the old behaviour).
# SCHEMA_SCOPE=auto
# SCHEMA_FULL_MAX_TOKENS=8000
# SCHEMA_WIDEN_ON_DEMAND=

# Web app (optional; read after this file is loaded, so values here apply).
# Full list: apps/web/README.md.
# WEB_API_TOKEN=            # bearer token; when set, the query routes and deep health
#                           # require it; /api/admin/* is disabled without it
# WEB_API_HOST=127.0.0.1
# WEB_API_PORT=8787
# WEB_FRONTEND_PORT=5173
# WEB_ALLOWED_HOSTS=        # extra Host names to accept (DNS-rebinding protection)
# WEB_ALLOWED_ORIGINS=      # browser origins allowed to call the API
# WEB_ALLOW_DEBUG=          # default: on for a loopback bind, off otherwise
# WEB_REQUEST_TIMEOUT_MS=120000

# Optional:
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
